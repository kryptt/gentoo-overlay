https://github.com/ROCm/rocm-systems/issues/284

rocr-runtime resolves these out of libhsakmt, but the version script keeps
them local, so libhsa-runtime64 ends up with undefined references. The set
is derived from `nm -D --undefined-only libhsa-runtime64.so` minus the
exports of libhsakmt.so.
--- a/src/libhsakmt.ver
+++ b/src/libhsakmt.ver
@@ -106,6 +106,12 @@
 hsaKmtMemoryCpuMap;
 hsaKmtSetSigbusDelay;
 hsaKmtGetAmdGPUDeviceFd;
+hsaKmtCreateQueueExt;
+hsaKmtCreateQueueV2;
+hsaKmtRegisterGraphicsHandleToNodesExt;
+hsaKmtModelEnabled;
+hsaKmtImportExternalSemaphore;
+hsaKmtDestroyExternalSemaphore;
 local: *;
 };
 
