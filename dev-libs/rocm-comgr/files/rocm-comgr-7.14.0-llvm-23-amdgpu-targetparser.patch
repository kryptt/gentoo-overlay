LLVM 23 split the AMDGPU target parser out of TargetParser.h into its own
AMDGPUTargetParser.h. ROCm's LLVM fork still re-exports it from the old
header, upstream LLVM does not, so the hotswap raiser fails with:

  error: 'llvm::AMDGPU' has not been declared
--- a/src/hotswap/raiser.cpp
+++ b/src/hotswap/raiser.cpp
@@ -15,7 +15,7 @@
 #include "llvm/IR/IRBuilder.h"
 #include "llvm/IR/LLVMContext.h"
 #include "llvm/IR/Module.h"
-#include "llvm/TargetParser/TargetParser.h"
+#include "llvm/TargetParser/AMDGPUTargetParser.h"
 #include "llvm/TargetParser/Triple.h"
 
 namespace COMGR::hotswap {
