The hotswap rewriter links per-component LLVM libs unconditionally;
on a dylib-only LLVM (Gentoo) those static libs do not exist and the
link of libamd_comgr fails. Link the dylib when LLVM_LINK_LLVM_DYLIB
is set, mirroring the guard in the top-level CMakeLists.txt.
--- a/src/hotswap/rewriter/CMakeLists.txt
+++ b/src/hotswap/rewriter/CMakeLists.txt
@@ -71,17 +71,21 @@ target_include_directories(hotswap-rewriter PUBLIC
 # assemble/encode (MC, MCParser, MCCodeEmitter), read ELF (Object,
 # BinaryFormat), and query AMDGPU MC descriptions (AMDGPU{Desc,Info,AsmParser,
 # Disassembler}). It uses no LLVM IR or codegen, so Core and AMDGPUCodeGen are
 # intentionally omitted; Core is still pulled in transitively where needed.
-llvm_map_components_to_libnames(hotswap_rewriter_llvm_libs
-  BinaryFormat
-  MC
-  MCDisassembler
-  MCParser
-  Object
-  Support
-  TargetParser
-  AMDGPUAsmParser
-  AMDGPUDesc
-  AMDGPUDisassembler
-  AMDGPUInfo)
+if(LLVM_LINK_LLVM_DYLIB)
+  set(hotswap_rewriter_llvm_libs LLVM)
+else()
+  llvm_map_components_to_libnames(hotswap_rewriter_llvm_libs
+    BinaryFormat
+    MC
+    MCDisassembler
+    MCParser
+    Object
+    Support
+    TargetParser
+    AMDGPUAsmParser
+    AMDGPUDesc
+    AMDGPUDisassembler
+    AMDGPUInfo)
+endif()
 
 target_link_libraries(hotswap-rewriter PUBLIC ${hotswap_rewriter_llvm_libs})
